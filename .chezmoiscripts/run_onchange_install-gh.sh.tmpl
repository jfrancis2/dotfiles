{{- if eq .chezmoi.os "linux" -}}
#!/bin/sh
# Installs the GitHub CLI into ~/.local/opt/gh/<version>, without root. ~/.local/bin/gh
# (dot_local/bin/executable_gh.tmpl) runs it. chezmoi re-runs this when the version changes.
# macOS gets gh from Homebrew instead.
set -eu

version=2.102.0
case "$(uname -m)" in
    x86_64) arch=amd64 ;;
    aarch64 | arm64) arch=arm64 ;;
    *) echo "install-gh: unsupported architecture $(uname -m), skipping" >&2; exit 0 ;;
esac

dest="$HOME/.local/opt/gh/$version"
[ -x "$dest/bin/gh" ] && exit 0

name="gh_${version}_linux_${arch}"
base="https://github.com/cli/cli/releases/download/v$version"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
curl -fsSL -o "$tmp/$name.tar.gz" "$base/$name.tar.gz"
curl -fsSL -o "$tmp/checksums.txt" "$base/gh_${version}_checksums.txt"
(cd "$tmp" && grep " $name.tar.gz\$" checksums.txt | sha256sum -c --quiet -)

tar -xzf "$tmp/$name.tar.gz" -C "$tmp"
mkdir -p "$(dirname "$dest")"
rm -rf "$dest"
mv "$tmp/$name" "$dest"
ln -sfn "$version" "$HOME/.local/opt/gh/current"
echo "install-gh: installed gh $version"
{{ end -}}
